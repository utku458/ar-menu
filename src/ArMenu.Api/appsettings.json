{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Jwt": {
      "Issuer": "armenu-api",
      "Audience": "armenu-dashboard",
      "AccessTokenLifetime": "00:15:00"
    },
    "Sessions": {
      "IdleTimeout": "14.00:00:00",
      "AbsoluteLifetime": "30.00:00:00"
    }
  },
  "Assets": {
    "PublicBaseUrl": "https://cdn.armenu.app/"
  },
  "Storage": {
    "UploadsBucket": "armenu-uploads",
    "AssetsBucket": "armenu-assets",
    "UploadUrlLifetime": "00:15:00"
  },
  "AssetProcessor": {
    "Timeout": "00:05:00",
    "Workers": 1,
    "PollInterval": "00:00:05",
    "Lease": "00:10:00"
  },
  "ArModelProcessing": {
    "RetryDelay": "00:00:30",
    "TransferUrlLifetime": "00:30:00"
  },
  "AssetCleanup": {
    "Interval": "01:00:00",
    "GracePeriod": "1.00:00:00"
  },
  "Email": {
    "Port": 587,
    "Security": "StartTls",
    "FromAddress": "no-reply@armenu.app",
    "FromName": "ArMenu"
  },
  "Dashboard": {
    "Url": "https://app.armenu.app/"
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthenticationPermitsPerMinute": 10,
    "SignUpPermitsPerHour": 5,
    "PublicMenuPermitsPerMinute": 300
  }
}
