root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,slnx,xml}]
indent_size = 2

[*.{ts,tsx,js,mjs,cjs,css,html,conf}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# --- Language style --------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_readonly_field = true:warning

# IDE0005: remove unnecessary usings (enforced in build, requires GenerateDocumentationFile).
dotnet_diagnostic.IDE0005.severity = warning
# IDE0161: file-scoped namespaces.
dotnet_diagnostic.IDE0161.severity = warning

# --- Naming ----------------------------------------------------------------
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_naming_rule.private_constants_pascal.symbols = private_constants
dotnet_naming_rule.private_constants_pascal.style = pascal_case
dotnet_naming_rule.private_constants_pascal.severity = warning
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private, private_protected
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_case
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private, private_protected
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly

# --- Analyzer tuning (each suppression is a deliberate decision) -----------
# CA1716: guards against names that are keywords in *other* .NET languages (e.g. VB's `Error`).
# This is a C#-only product, and `Error` is the idiomatic name in the Result pattern.
dotnet_diagnostic.CA1716.severity = none
# CA1848/CA1873: LoggerMessage source generators are used where logging is hot; not mandatory everywhere.
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion

[tests/**.cs]
# Test method names use underscores for readability: Method_Scenario_ExpectedResult.
dotnet_diagnostic.CA1707.severity = none
# xUnit test classes and fixtures are instantiated by the framework.
dotnet_diagnostic.CA1812.severity = none
# Tests are not a public API surface.
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2007.severity = none

[**/Migrations/{2*.cs,*ModelSnapshot.cs}]
# EF Core generated code (timestamped migrations and the model snapshot).
generated_code = true
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0161.severity = none
